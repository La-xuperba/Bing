# Variable NAMES only - never commit real values. In GitHub use Settings > Secrets and variables > Actions.

# --- Telegram (official Bot API) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Binance Square (documented OpenAPI, text posts). Leave empty to save drafts instead ---
BINANCE_SQUARE_API_KEY=

# --- Reserved (original bot has no market-cap logic, currently unused) ---
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=

# --- Original scanner settings (same defaults as before) ---
MIN_SCORE=45
MAX_WORKERS=8
BINANCE_BASE_URL=https://data-api.binance.vision

# --- Flash pump alerts ---
FLASH_THRESHOLD_PCT=5
FLASH_COOLDOWN_MINUTES=60
FLASH_EXCHANGES=binance,gate
FLASH_MAX_AGE_MINUTES=45
FLASH_WORKERS=6
BINANCE_RPS=12
GATE_RPS=12
GATE_MIN_QUOTE_VOLUME_24H=0

# --- Signals ---
SIGNAL_COOLDOWN_MINUTES=120
SIGNAL_SCAN_INTERVAL_MINUTES=15
SIGNAL_MAX_AGE_MINUTES=120
FORCE_SIGNAL_SCAN=

# --- Publishing ---
POST_DELAY_MIN_SECONDS=10
POST_DELAY_MAX_SECONDS=20
BOT_MAX_RUNTIME_SECONDS=600
MAX_ITEM_ATTEMPTS=3

# --- Paths / modes ---
BOT_STATE_PATH=state/state.json
BOT_DRAFT_PATH=square_drafts.txt
DRY_RUN=
